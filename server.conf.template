server {
    listen ${HTTP_LISTEN_PORT};
    listen ${HTTPS_LISTEN_PORT} ssl;
    http2 on;
    server_name _;

    ssl_certificate ${SERVER_CERT};
    ssl_certificate_key ${SERVER_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;

    resolver ${NAME_RESOLVER} ipv6=off;
    set $backend_upstream "${UPSTREAM_URL}";
    set $verbose_error_pages "${VERBOSE_ERROR_PAGES}";
    set $feedback_email "${FEEDBACK_EMAIL}";

    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Content-Type-Options nosniff always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    include /var/lib/nginx/runtime/extra-server.conf;

    error_page 403 /nginx-proxy/403.shtml;
    error_page 404 /nginx-proxy/404.shtml;
    error_page 429 /nginx-proxy/429.shtml;
    error_page 500 /nginx-proxy/500.shtml;
    error_page 501 /nginx-proxy/501.shtml;
    error_page 502 /nginx-proxy/502.shtml;
    error_page 503 /nginx-proxy/503.shtml;
    error_page 504 /nginx-proxy/504.shtml;
    error_page 418 /nginx-proxy/418-request-denied.shtml;

    location = /public/css/app.css {
        alias /public/css/app.css;
    }

    location = /public/images/govuk-logo.svg {
        alias /public/images/govuk-logo.svg;
    }

    location ^~ /nginx-proxy/ {
        alias /usr/share/nginx/html/;
        ssi on;
    }

    location = /ping {
        access_log off;
        return 200;
    }

    location = /RequestDenied {
        internal;
        return 418;
    }

    location / {
        include /var/lib/nginx/runtime/rate-limit-location.conf;

        include /var/lib/nginx/runtime/redirect.conf;
        SecRulesEnabled;
        DeniedUrl "/RequestDenied";
        CheckRule "$SQL >= 8" BLOCK;
        CheckRule "$RFI >= 8" BLOCK;
        CheckRule "$TRAVERSAL >= 4" BLOCK;
        CheckRule "$EVADE >= 4" BLOCK;
        CheckRule "$XSS >= 8" BLOCK;
        include /etc/nginx/naxsi.d/*.rules;
        include /var/lib/nginx/runtime/extra-naxsi.rules;

        proxy_intercept_errors off;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_pass $backend_upstream;
    }
}
